        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="#Raw Data, takes data everytime a point happens, everytime a click happens, everytime a phase chnage happens, everytime an error happens&amp;#10;RawData = data.ExperimentHandler(name = &quot;DROIntegrity&quot;, dataFileName ='RawData')&amp;#10;#Clicks data, Takes data everytime a click happens&amp;#10;click = data.ExperimentHandler(name='DROIntegrity', dataFileName='ClicksData')&amp;#10;point1 = 0 &amp;#10;point2 = 0&amp;#10;&amp;#10;Visual1Timer = core.Clock()&amp;#10;Visual2Timer = core.Clock()&amp;#10;Visual1Timer.reset()&amp;#10;Visual2Timer.reset()&amp;#10;CircleOn = 1&amp;#10;xpos = 0&amp;#10;ypos = 0&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="&amp;#10;&amp;#10;point1 = 0;&amp;#10;point2 = 0;&amp;#10;Visual1Timer = new util.Clock();&amp;#10;Visual2Timer = new util.Clock();&amp;#10;Visual1Timer.reset();&amp;#10;Visual2Timer.reset();&amp;#10;CircleOn = 1;&amp;#10;xpos = 0;&amp;#10;ypos = 0;&amp;#10;RunTimer = new util.Clock();&amp;#10;RunTimer.reset();&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="CircleOn = 1;&amp;#10;MouseTimer = new util.Clock();&amp;#10;MouseTimer.reset();&amp;#10;DROTimer = new util.Clock();&amp;#10;DROTimer.reset();&amp;#10;FITimer = new util.Clock();&amp;#10;FITimer.reset();&amp;#10;FTTimer = new util.Clock();&amp;#10;FTTimer.reset();&amp;#10;PhaseTimer = new util.Clock();&amp;#10;PhaseTimer.reset();&amp;#10;psychoJS.window.color = new util.Color(BackgroundColor);&amp;#10;PointsBox1.setFillColor(BackgroundColor);&amp;#10;PointsBox2.setFillColor(BackgroundColor);" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="CircleOn = 1&amp;#10;MouseTimer = core.Clock()&amp;#10;MouseTimer.reset()&amp;#10;DROTimer = core.Clock()&amp;#10;DROTimer.reset()&amp;#10;FITimer = core.Clock()&amp;#10;FITimer.reset()&amp;#10;FTTimer = core.Clock()&amp;#10;FTTimer.reset()&amp;#10;&amp;#10;PhaseTimer = core.Clock();&amp;#10;PhaseTimer.reset()" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="JS" valType="str" updates="None" name="Code Type"/>
        <Param val="def PointAwarded():&amp;#10; &amp;#10;    point1 += Points1&amp;#10;    point2 += Points2&amp;#10;    if Points1 != 0:&amp;#10;        Visual1Timer.reset()&amp;#10;      &amp;#10;        Sound1.play()&amp;#10;    if Points2 != 0:&amp;#10;        Visual2Timer.reset()&amp;#10;        &amp;#10;        Sound2.play()&amp;#10;if mouse.isPressedIn(button) and CircleOn==1:&amp;#10;    #This section of code moves button around gracefully&amp;#10;    CircleOn = 0&amp;#10;    x = win.size[0]&amp;#10;    y = win.size[1]&amp;#10;    button.setOpacity(0)&amp;#10;    button.setPos((random()*((x/y)-0.05) - ((x/y)/2) + 0.025, (random()*.8) - 0.45), log=False)&amp;#10;    MouseTimer.reset()&amp;#10;    #ResetDROTimer&amp;#10;    DROTimer.reset()&amp;#10;    #This will award points when button is clicked during FI schedule&amp;#10;    if Reinforcement_Schedule == &quot;FI&quot; and FITimer.getTime() &gt; Reinforcement_Variable:&amp;#10;        PointAwarded()&amp;#10;        FITimer.reset()&amp;#10;#turns button back on    &amp;#10;if MouseTimer.getTime() &gt; 0.3:&amp;#10;    CircleOn = 1&amp;#10;    button.setOpacity(1)&amp;#10;#turns pointlights on and off&amp;#10;if PhaseTimer.getTime() &gt; 0.8:&amp;#10;    if Visual1Timer.getTime() &lt; 0.8:&amp;#10;        PointsBox1.setFillColor([0.0000,0.9059,0.0000])&amp;#10;    else:&amp;#10;        PointsBox1.setFillColor([0.0000,0,0])&amp;#10;    if Visual2Timer.getTime() &lt; 0.8:&amp;#10;        PointsBox2.setFillColor([0.0000,0.9059,0.0000])&amp;#10;    else:&amp;#10;        PointsBox2.setFillColor([0.0000,0,0])&amp;#10;   &amp;#10;#This will award points when DRO is satisfied&amp;#10;if Reinforcement_Schedule == &quot;DRO&quot; and DROTimer.getTime() &gt; Reinforcement_Variable:&amp;#10;    PointAwarded()&amp;#10;    DROTimer.reset()&amp;#10;#This will award points when FT is satisfied&amp;#10;if Reinforcement_Schedule == &quot;FT&quot; and FTTimer.getTime() &gt; Reinforcement_Variable:&amp;#10;    PointAwarded()&amp;#10;    FTTimer.reset()&amp;#10;if PhaseTimer.getTime() &gt; Duration:&amp;#10;    continueRoutine = False&amp;#10;    &amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="function PointAwarded(Reason) {&amp;#10;    point1 += Points1;&amp;#10;    point2 += Points2;&amp;#10;    if ((Points1 !== 0)) {&amp;#10;        Visual1Timer.reset();&amp;#10;        Sound1.play();&amp;#10;    }&amp;#10;    if ((Points2 !== 0)) {&amp;#10;        Visual2Timer.reset();&amp;#10;        Sound2.play();&amp;#10;    }&amp;#10;     TimeStampData()&amp;#10;     psychoJS.experiment.addData(&quot;datatype&quot;, &quot;PointEarned&quot;)&amp;#10;     psychoJS.experiment.addData(&quot;ReasonforPoint&quot;, Reason)&amp;#10;     psychoJS.experiment.addData(&quot;TotalPoints1&quot;, point1)&amp;#10;     psychoJS.experiment.addData(&quot;TotalPoints2&quot;, point2)&amp;#10;     psychoJS.experiment.nextEntry()&amp;#10;}  &amp;#10;function TimeStampData() {&amp;#10;     psychoJS.experiment.addData(&quot;RunTimer&quot;, RunTimer.getTime())&amp;#10;     psychoJS.experiment.addData(&quot;PhaseTimer&quot;, PhaseTimer.getTime())&amp;#10;     &amp;#10;     psychoJS.experiment.addData(&quot;CurentPhase&quot;, PhaseName)&amp;#10;}&amp;#10;&amp;#10;if ((mouse.isPressedIn(button) &amp;&amp; (CircleOn === 1))) {&amp;#10;    CircleOn = 0;&amp;#10;    x = psychoJS.window.size[0];&amp;#10;    y = psychoJS.window.size[1];&amp;#10;    button.setOpacity(0);&amp;#10;    button.setPos([(((Math.random() * ((x / y) - 0.05)) - ((x / y) / 2)) + 0.025), ((Math.random() * 0.8) - 0.45)], {&quot;log&quot;: false});&amp;#10;    MouseTimer.reset();&amp;#10;    DROTimer.reset();&amp;#10;    &amp;#10;    if (((Reinforcement_Schedule === &quot;FI&quot;) &amp;&amp; (FITimer.getTime() &gt; Reinforcement_Variable))) {&amp;#10;        new PointAwarded(&quot;FI click&quot;);&amp;#10;        FITimer.reset();&amp;#10;    }&amp;#10;    TimeStampData()&amp;#10;    psychoJS.experiment.addData(&quot;datatype&quot;, &quot;ButtonClicked&quot;)&amp;#10;    psychoJS.experiment.addData(&quot;TotalPoints1&quot;, point1)&amp;#10;    psychoJS.experiment.addData(&quot;TotalPoints2&quot;, point2)&amp;#10;    psychoJS.experiment.nextEntry()&amp;#10;}   &amp;#10;if ((MouseTimer.getTime() &gt; 0.3)) {&amp;#10;    CircleOn = 1;&amp;#10;    button.setOpacity(1);&amp;#10;}&amp;#10;//Turns point colors on and off&amp;#10;if ((PhaseTimer.getTime() &gt; 0.8)) {&amp;#10;    if ((Visual1Timer.getTime() &lt; 0.8)) {&amp;#10;        PointsBox1.setFillColor([0.0, 0.9059, 0.0]);&amp;#10;    } else {&amp;#10;        PointsBox1.setFillColor(BackgroundColor);&amp;#10;    }&amp;#10;    if ((Visual2Timer.getTime() &lt; 0.8)) {&amp;#10;        PointsBox2.setFillColor([0.2, -0.6078, 0.6]);&amp;#10;    } else {&amp;#10;        PointsBox2.setFillColor(BackgroundColor);&amp;#10;    }&amp;#10;}&amp;#10;if (((Reinforcement_Schedule === &quot;DRO&quot;) &amp;&amp; (DROTimer.getTime() &gt; Reinforcement_Variable))) {&amp;#10;    new PointAwarded(&quot;DRO&quot;);&amp;#10;    DROTimer.reset();&amp;#10;}&amp;#10;if (((Reinforcement_Schedule === &quot;FT&quot;) &amp;&amp; (FTTimer.getTime() &gt; Reinforcement_Variable))) {&amp;#10;    new PointAwarded(&quot;FT&quot;);&amp;#10;    FTTimer.reset();&amp;#10;}&amp;#10;if ((PhaseTimer.getTime() &gt; Duration)) {&amp;#10;    continueRoutine = false;&amp;#10;    TimeStampData()&amp;#10;    psychoJS.experiment.addData(&quot;datatype&quot;, &quot;PhaseChange&quot;)&amp;#10;    psychoJS.experiment.addData(&quot;TotalPoints1&quot;, point1)&amp;#10;    psychoJS.experiment.addData(&quot;TotalPoints2&quot;, point2)&amp;#10;    psychoJS.experiment.nextEntry()&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code" valType="code" updates="None" name="name"/>
      </CodeComponent>
